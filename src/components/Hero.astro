---
import { ArrowDown, DownloadSimple, GithubLogo, LinkedinLogo } from "@phosphor-icons/react/dist/ssr";
import type { Dict } from "@/content";
import Bezel from "./Bezel.astro";
import Icon from "./Icon.astro";
import * as si from "simple-icons";
import { withBase } from "./ui";

const { hero, contact } = Astro.props as { hero: Dict["hero"]; contact: Dict["contact"]["direct"]; dict?: Dict };
const t = hero.terminal;

/* ---- tech ticker: brand icon + colour per tag ---- */
type Tool = { name: string; hex: string; si?: string; icon?: string };
const tools: Tool[] = [
  { name: "TypeScript", hex: "3178C6", si: "siTypescript" },
  { name: "Python", hex: "3776AB", si: "siPython" },
  { name: "FastAPI", hex: "009688", si: "siFastapi" },
  { name: "React", hex: "61DAFB", si: "siReact" },
  { name: "Next.js", hex: "9ca3af", si: "siNextdotjs" },
  { name: "Kotlin", hex: "7F52FF", si: "siKotlin" },
  { name: "Spring Boot", hex: "6DB33F", si: "siSpringboot" },
  { name: "Flutter", hex: "02569B", si: "siFlutter" },
  { name: "PostgreSQL", hex: "4169E1", si: "siPostgresql" },
  { name: "MongoDB", hex: "47A248", si: "siMongodb" },
  { name: "Redis", hex: "DC382D", si: "siRedis" },
  { name: "RabbitMQ", hex: "FF6600", si: "siRabbitmq" },
  { name: "Pinecone", hex: "5b8cff", icon: "database" },
  { name: "LangChain", hex: "34d399", si: "siLangchain" },
  { name: "LlamaIndex", hex: "c084fc", icon: "layers" },
  { name: "Claude", hex: "d97757", si: "siClaude" },
  { name: "CopilotKit", hex: "f472b6", icon: "sparkles" },
  { name: "A2A", hex: "a78bfa", icon: "layers" },
  { name: "AG-UI", hex: "34d399", icon: "layout" },
  { name: "n8n", hex: "EA4B71", si: "siN8n" },
  { name: "AWS", hex: "FF9900", icon: "cloud" },
  { name: "Azure", hex: "0078D4", icon: "cloud" },
  { name: "Docker", hex: "2496ED", si: "siDocker" },
  { name: "Kubernetes", hex: "326CE5", si: "siKubernetes" },
  { name: "Terraform", hex: "7B42BC", si: "siTerraform" },
  { name: "GitHub Actions", hex: "2088FF", si: "siGithubactions" },
  { name: "GitLab CI", hex: "FC6D26", si: "siGitlab" },
  { name: "Grafana", hex: "F46800", si: "siGrafana" },
  { name: "Prometheus", hex: "E6522C", si: "siPrometheus" },
  { name: "Playwright", hex: "2EAD33", icon: "flask" },
  { name: "Jira", hex: "0052CC", si: "siJira" },
  { name: "Figma", hex: "F24E1E", si: "siFigma" },
];
const brand: Record<string, { path?: string; hex: string; icon?: string }> = Object.fromEntries(
  tools.map((x) => [x.name, { path: x.si ? (si as Record<string, { path: string }>)[x.si]?.path : undefined, hex: x.hex, icon: x.icon ?? "star" }]),
);
const rowA = tools.filter((_, i) => i % 2 === 0).map((x) => x.name);
const rowB = tools.filter((_, i) => i % 2 === 1).map((x) => x.name);
const social =
  "inline-flex items-center gap-2 rounded-full px-3 py-2 text-[13px] text-ink-soft transition-colors duration-500 hover:text-ink";
---
<section id="top" data-hero-section class="hero-glass relative flex min-h-[100dvh] items-center overflow-hidden pb-16 pt-24">
  <!-- Ambient depth: masked grid and slow orbs, parallaxed by scroll + pointer. -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="grid-backdrop absolute inset-0 opacity-60" data-parallax="0.15"></div>
    <div data-orb="40" class="absolute -top-48 left-[8%] h-[40rem] w-[40rem]">
      <div class="hero-orb-a h-full w-full rounded-full blur-[140px]"></div>
    </div>
    <div data-orb="-30" class="absolute -right-32 top-1/3 h-[30rem] w-[30rem]">
      <div class="hero-orb-b h-full w-full rounded-full blur-[130px]"></div>
    </div>
  </div>

  <div class="mx-auto w-full max-w-[1440px] px-5 sm:px-8">
    <div data-hero-grid class="grid gap-16 lg:grid-cols-[1.25fr_0.75fr] lg:items-center">
      <div data-hero-copy>
        <span data-hero class="eyebrow hero-badge !normal-case !tracking-normal">
          <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success opacity-70"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-success"></span>
          </span>
          {hero.available}
        </span>

        <h1
          data-split="hero"
          class="mt-8 font-display text-[clamp(3.25rem,10.5vw,8.75rem)] font-semibold leading-[0.92] tracking-tighter text-ink"
        >{hero.name}</h1>

        <div data-hero>
          <div class="mt-8 flex flex-wrap items-center gap-2">
            <span class="hero-chip hero-chip-main">{hero.role}</span>
            {hero.focus.split(" · ").map((f) => <span class="hero-chip">{f}</span>)}
          </div>
          <p class="mt-5 max-w-[34ch] text-xl leading-snug tracking-tight text-ink sm:text-2xl">{hero.statement}</p>
        </div>

        <div data-hero class="mt-10 flex flex-wrap items-center gap-3">
          <a href="#projects" class="btn btn-primary hero-cta">
            {hero.viewWork}
            <span class="btn-icon" aria-hidden="true"><ArrowDown size={16} weight="light" /></span>
          </a>
          <a href={withBase("/cv.pdf")} download class="btn btn-ghost hero-cta-ghost">
            {hero.downloadCv}
            <span class="btn-icon" aria-hidden="true"><DownloadSimple size={16} weight="light" /></span>
          </a>
          <div class="flex items-center sm:ml-2">
            <a href={contact.githubUrl} target="_blank" rel="noreferrer noopener" class={social}>
              <GithubLogo size={18} weight="light" aria-hidden="true" />
              {contact.githubLabel}
            </a>
            <a href={contact.linkedinUrl} target="_blank" rel="noreferrer noopener" class={social}>
              <LinkedinLogo size={18} weight="light" aria-hidden="true" />
              {contact.linkedinLabel}
            </a>
          </div>
        </div>
      </div>

      <div data-hero="card" data-hero-card>
        <div class="hero-float">
        <Bezel tilt float={false} class="lg:rotate-[1.6deg]" core="core-accent">
          <div class="p-6 sm:p-8">
            <p class="font-mono text-[12px] text-ink-faint">{t.file}</p>
            <div class="mt-6 space-y-2 font-mono text-[13px]">
              <p class="text-ink-faint" data-term><span class="text-accent">$</span> <span data-type>{t.whoamiCmd}</span></p>
              <p class="text-ink" data-term>{t.whoami}</p>
            </div>
            <p class="mt-7 font-mono text-[13px] text-ink-faint" data-term>
              <span class="text-accent">$</span> <span data-type>{t.statsCmd}</span>
            </p>
            <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-7">
              {t.stats.map((s) => (
                <div data-term>
                  <dt data-count class="font-display text-5xl font-semibold tracking-tighter text-ink">{s.value}</dt>
                  <dd class="mt-1.5 text-[12.5px] leading-snug text-ink-soft">{s.label}</dd>
                </div>
              ))}
            </dl>
            <p class="mt-8 font-mono text-[13px] text-ink-faint" data-term>
              <span class="text-accent">$</span> <span data-type>{t.availabilityCmd}</span>
            </p>
            <p class="mt-2 font-mono text-[13px] text-ink-soft" data-term>
              {t.availability}
              <span class="ml-1 inline-block h-3.5 w-2 translate-y-0.5 animate-blink bg-accent/80" aria-hidden="true"></span>
            </p>
          </div>
        </Bezel>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Ad-style ticker: two rows running in opposite directions, speed follows
     scroll velocity (motion.ts). Static row when motion is off. -->
<div
  data-marquee
  class="relative space-y-4 overflow-hidden py-10 [mask-image:linear-gradient(to_right,transparent,#000_10%,#000_90%,transparent)]"
  aria-label={tools.map((x) => x.name).join(", ")}
>
  {[1, -1].map((dir) => (
    <div data-marquee-track data-dir={dir} class="marquee-track flex w-max" aria-hidden="true">
      {[0, 1, 2, 3].map(() => (
        <ul class="flex shrink-0 items-center gap-4 pr-4">
          {(dir === 1 ? rowA : [...rowB].reverse()).map((tag, ti) => (
            <li class="flex items-center gap-4">
              <span class="tk-pill" style={`--c:#${(brand[tag] ?? { hex: "888888" }).hex};--d:${(ti % 7) * -0.6}s`}>
                <span class="tk-icon" style={`animation-delay:${(ti % 6) * -0.17}s`}>
                  {brand[tag]?.path ? (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={brand[tag].path} /></svg>
                  ) : (
                    <Icon name={brand[tag]?.icon ?? "star"} class="h-full w-full" />
                  )}
                </span>
                {tag}
              </span>
              <span class="h-1.5 w-1.5 rotate-45 bg-accent/70"></span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  ))}
</div>
