---
import { localeMeta, locales, type Locale } from "@/content";
import { withBase } from "./ui";

const { current, label } = Astro.props as { current: Locale; label: string };
---
<!-- data-astro-reload: a full load per language. The ClientRouter swap left the
     component scripts (skills tabs, terminal, build) bound to the old page. -->
<div role="group" aria-label={label} class="flex items-center rounded-full bg-ink/6 p-0.5 font-mono text-[12px]">
  {locales.map((l) => (
    <a
      href={withBase(`/${l}/`)}
      data-astro-reload
      hreflang={localeMeta[l].htmlLang}
      lang={localeMeta[l].htmlLang}
      aria-label={localeMeta[l].name}
      title={localeMeta[l].name}
      aria-current={l === current ? "true" : undefined}
      class:list={[
        "rounded-full px-2 py-1.5 transition-colors duration-500 sm:px-2.5",
        l === current ? "bg-ink/12 text-ink" : "text-ink-soft hover:text-ink",
      ]}
    >{localeMeta[l].label}</a>
  ))}
</div>
