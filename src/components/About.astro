---
import type { Dict } from "@/content";
import Bezel from "./Bezel.astro";
import Icon from "./Icon.astro";
import MonoLabel from "./MonoLabel.astro";
import Reveal from "./Reveal.astro";
import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";
import { bentoTone, withBase } from "./ui";

const { about } = Astro.props as { about: Dict["about"] };
const icons = ["sparkles", "shield", "layers", "flask", "server", "rocket"];
const [tools, style, where] = about.collab;
const chip = "inline-flex items-center gap-1.5 rounded-full border border-rule bg-accent-soft px-3 py-1 text-[13px] text-accent-soft-ink";
---
<Section id="about">
  <SectionHead eyebrow={about.eyebrow} title={about.title} />

  <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
    <div>
      <p class="max-w-[28ch] font-display text-3xl font-semibold leading-[1.2] tracking-tight text-ink sm:text-4xl">{about.paragraphs[0]}</p>
      {about.paragraphs.slice(1).map((p) => (
        <p class="mt-5 max-w-[48ch] text-lg leading-relaxed text-ink-soft">{p}</p>
      ))}

      <div class="mt-12 grid gap-4 sm:grid-cols-2">
        {about.principles.map((pr, i) => (
          <Reveal variant="card">
            <Bezel lift tilt class="h-full" core={`p-6 ${bentoTone(i)}`}>
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-accent-soft text-accent">
                <Icon name={icons[i % icons.length]} />
              </span>
              <h3 class="mt-5 font-display text-lg font-semibold tracking-tight text-ink">{pr.title}</h3>
              <p class="mt-2 text-[14px] leading-relaxed text-ink-soft">{pr.body}</p>
            </Bezel>
          </Reveal>
        ))}
      </div>
    </div>

    <Reveal>
      <Bezel class="lg:sticky lg:top-24" core="p-7 sm:p-9">
        <div class="relative mb-6">
          <img
            src={withBase("/portrait.jpg")}
            alt="Portrait of Soe Moe Htet"
            width="800"
            height="1000"
            loading="lazy"
            decoding="async"
            class="aspect-[4/5] w-full rounded-2xl object-cover object-[50%_30%] ring-1 ring-inset ring-rule"
          />
          <div class="absolute inset-x-3 bottom-3 flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-glass px-3 py-1.5 text-[12px] text-ink backdrop-blur-md">
              <Icon name="pin" class="h-3.5 w-3.5 text-accent" /> {where.value.split(" · ")[0]}
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-glass px-3 py-1.5 text-[12px] text-ink backdrop-blur-md">
              <Icon name="users" class="h-3.5 w-3.5 text-accent" /> {where.value.split(" · ")[1]}
            </span>
          </div>
        </div>

        <MonoLabel>{about.collabTitle}</MonoLabel>
        <div class="mt-3 flex flex-wrap gap-2">
          {tools.value.split(", ").map((t) => <span class={chip}>{t}</span>)}
        </div>
        <p class="mt-3 text-[13px] text-ink-soft">{style.value}</p>

        <div class="my-7 h-px bg-rule"></div>
        <MonoLabel>{about.educationTitle}</MonoLabel>
        <ol class="mt-4 space-y-4 border-l border-rule pl-5">
          {about.education.map((e) => (
            <li class="relative">
              <span class="absolute -left-[26px] top-1.5 h-2.5 w-2.5 rounded-full bg-accent ring-4 ring-accent-soft"></span>
              <p class="text-[15px] text-ink">{e.school}</p>
              <p class="text-[13px] text-ink-soft">{e.degree}</p>
              <p class="mt-0.5 font-mono text-[12px] text-ink-faint">{e.period}</p>
            </li>
          ))}
        </ol>

        <div class="my-7 h-px bg-rule"></div>
        <MonoLabel>{about.languagesTitle}</MonoLabel>
        <ul class="mt-4 space-y-3">
          {about.languages.map((l) => (
            <li class="flex items-center justify-between gap-4 text-[14px]">
              <span class="text-ink">{l.name}</span>
              <span class="flex items-center gap-3 text-ink-soft">
                <span class="text-[12px]">{l.level}</span>
                <span class="flex gap-1" aria-hidden="true">
                  {[1, 2, 3, 4, 5].map((n) => (
                    <span class:list={["h-1.5 w-4 rounded-full", n <= l.bars ? "bg-accent" : "bg-rule"]}></span>
                  ))}
                </span>
              </span>
            </li>
          ))}
        </ul>

        <div class="my-7 h-px bg-rule"></div>
        <MonoLabel>{about.awardsTitle}</MonoLabel>
        <ul class="mt-4 space-y-2">
          {about.awards.map((a) => (
            <li class="flex items-center gap-3 text-[14px] text-ink-soft">
              <Icon name="trophy" class="h-4 w-4 shrink-0 text-accent" /> {a}
            </li>
          ))}
        </ul>

        <div class="my-7 h-px bg-rule"></div>
        <MonoLabel>{about.activitiesTitle}</MonoLabel>
        <ul class="mt-4 flex flex-wrap gap-2">
          {about.activities.map((a) => (
            <li class="rounded-full border border-rule px-3 py-1 text-[13px] text-ink-soft" title={a.body}>{a.title}</li>
          ))}
        </ul>
      </Bezel>
    </Reveal>
  </div>
</Section>
